---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import FaqItem from '../components/FaqItem.astro';
import Icon from '../components/Icon.astro';
import Value from '../components/Value.astro';
import type { Props as IconProps } from '../components/Icon.astro';
import { SITE, purchaseHref } from '../data/site';

interface Step {
  number: string;
  eyebrow: string;
  title: string;
  body: string;
  points: string[];
  photo: string;
  src?: string;
  icon: IconProps['name'];
}

const steps: Step[] = [
  {
    number: '01',
    eyebrow: 'Ingredients',
    title: '가평의 원료를 고릅니다',
    body: '깨끗한 물과 공기가 살아 있는 가평에서 자란 원료로 시작합니다. 모든 쌀은 무농약 인증 쌀을, 찹쌀은 유기농 인증 찹쌀을 사용합니다.',
    points: ['무농약 인증 쌀', '유기농 인증 찹쌀', '가평 우렁이 농법 쌀'],
    photo: '가평 논·원료',
    icon: 'field',
  },
  {
    number: '02',
    eyebrow: 'Cooking',
    title: '공유주방 설비에서 밥을 짓습니다',
    body: '가평군농업기술센터 거점농산물가공센터의 공유주방 즉석밥 설비에서 제품별 원료를 더해 밥을 짓습니다.',
    points: ['거점농산물가공센터', '즉석밥 전용 설비'],
    photo: '거점농산물가공센터 즉석밥 충전 설비',
    src: '/images/facility/filling.webp',
    icon: 'bowl',
  },
  {
    number: '03',
    eyebrow: 'Sterilization',
    title: '레토르트 공정으로 멸균합니다',
    body: '레토르트식품 HACCP 기준에 따라 포장한 밥을 멸균합니다. 그래서 실온에 보관했다가 바로 데워 드실 수 있습니다.',
    points: ['레토르트식품 HACCP', '멸균 공정'],
    photo: '거점농산물가공센터 레토르트 멸균기',
    src: '/images/facility/retort.webp',
    icon: 'shield',
  },
  {
    number: '04',
    eyebrow: 'Inspection',
    title: '금속검출을 거쳐 출하합니다',
    body: '금속검출 공정을 거친 제품만 포장해 식탁으로 보냅니다.',
    points: ['금속검출 공정', '개별 포장'],
    photo: '즉석밥 용기 실링·포장 공정',
    src: '/images/facility/sealing.webp',
    icon: 'scan',
  },
];

interface Doc {
  title: string;
  image: string;
  alt: string;
  kind: 'cert' | 'photo';
  details: { label: string; value: string }[];
}

// 인증서 이미지는 개인정보(생년월일, 개인 생산자 이름·주소)를 가린 사본이다.
const documents: Doc[] = [
  {
    title: '레토르트식품 HACCP 인증',
    image: '/images/certs/haccp.webp',
    alt: '식품안전관리인증기준(HACCP) 적용업소 인증서, 제 2026-1-0227 호',
    kind: 'cert',
    details: [
      { label: '인증번호', value: '제 2026-1-0227 호' },
      { label: '식품 종별', value: '레토르트식품(즉석조리식품)' },
      { label: '중요관리점', value: '멸균, 금속검출' },
      { label: '유효기간', value: '2026.05.07 ~ 2029.05.06' },
      { label: '인증기관', value: '한국식품안전관리인증원' },
    ],
  },
  {
    title: '무농약 인증 쌀',
    image: '/images/certs/non-pesticide.webp',
    alt: '무농약농산물 인증서, 제 10304127 호',
    kind: 'cert',
    details: [
      { label: '인증번호', value: '제 10304127 호' },
      { label: '인증품목', value: '벼 외 1품목' },
      { label: '생산자', value: '가평군 조종면 현리친환경단지' },
      { label: '유효기간', value: '2025.10.11 ~ 2026.10.10' },
      { label: '인증기관', value: '(주)케이농식품인증센터' },
    ],
  },
  {
    title: '유기농 인증 찹쌀',
    image: '/images/certs/organic.webp',
    alt: '유기농산물 인증서, 제 10100657 호',
    kind: 'cert',
    details: [
      { label: '인증번호', value: '제 10100657 호' },
      { label: '인증품목', value: '찰벼' },
      { label: '생산지', value: '가평군 가평읍' },
      { label: '유효기간', value: '2025.09.24 ~ 2026.09.23' },
      { label: '인증기관', value: '(주)케이농식품인증센터' },
    ],
  },
  {
    title: '생산 시설',
    image: '/images/facility/line.webp',
    alt: '거점농산물가공센터 즉석밥 생산 라인',
    kind: 'photo',
    details: [
      { label: '시설', value: '가평군농업기술센터 거점농산물가공센터' },
      { label: '설비', value: '공유주방 즉석밥 생산 라인' },
    ],
  },
