---
interface Props { onDark?: boolean }
const { onDark = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--on-dark': onDark }]} aria-label="다온한끼 홈">
  <span class="logo__mark" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 19c0-8 5.5-14 15-14 0 10-6 15-12.5 15-1 0-1.8-.3-2.5-1Z"/><path d="M5 19l8-8"/>
    </svg>
  </span>
  <span class="logo__text" aria-hidden="true">다온한끼</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch-min);
    color: var(--color-ink);
    text-decoration: none;
  }
  .logo--on-dark { color: var(--color-on-dark); }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-md);
    background: var(--color-brand-turmeric);
    color: var(--color-primary);
  }
  .logo__text {
    font-size: 20px;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.5px;
  }
</style>
