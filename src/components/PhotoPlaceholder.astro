---
// 실제 사진이 들어오기 전 자리표시. src를 넘기면 사진을 쓴다.
import Icon from './Icon.astro';
import type { Props as IconProps } from './Icon.astro';
interface Props {
  label: string;
  tone?: 'leaf' | 'turmeric' | 'surface';
  ratio?: string;
  icon?: IconProps['name'];
  src?: string;
  class?: string;
}
const { label, tone = 'leaf', ratio = '4 / 3', icon = 'field', src, class: className } = Astro.props;
---
<div class:list={['photo', `photo--${tone}`, className]} style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <img src={src} alt={label} loading="lazy" decoding="async" />
  ) : (
    <div class="photo__placeholder" role="img" aria-label={`${label} 사진 자리 (실제 사진으로 교체 예정)`}>
      <Icon name={icon} size={48} />
      <span>[{label} 사진]</span>
    </div>
  )}
</div>

<style>
  .photo { overflow: hidden; border-radius: var(--rounded-xxxl); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo--leaf { background: var(--color-leaf-light); color: var(--color-leaf-dark); }
  .photo--turmeric { background: var(--color-turmeric-light); color: var(--color-turmeric-dark); }
  .photo--surface { background: var(--color-surface); color: var(--color-steel); }
  .photo__placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    text-align: center;
  }
</style>
