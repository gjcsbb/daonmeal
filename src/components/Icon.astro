---
// 1.8px 스트로크 라인 아이콘. 장식용이면 label 없이 쓰고 aria-hidden 처리된다.
export interface Props {
  name: 'leaf' | 'shield' | 'bowl' | 'microwave' | 'check' | 'arrow' | 'menu' | 'close' | 'sprout' | 'scan' | 'field' | 'truck' | 'handshake' | 'snail';
  size?: number;
  label?: string;
}
const { name, size = 24, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  leaf: '<path d="M5 19c0-8 5.5-14 15-14 0 10-6 15-12.5 15-1 0-1.8-.3-2.5-1Z"/><path d="M5 19l8-8"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/>',
  bowl: '<path d="M3 11h18a9 9 0 0 1-18 0Z"/><path d="M8 7c0-1.5 1-2 1-3.5M12 7c0-1.5 1-2 1-3.5M16 7c0-1.5 1-2 1-3.5"/>',
  microwave: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><rect x="5.5" y="8" width="10" height="8" rx="1"/><path d="M18.5 9v.01M18.5 12v.01M18.5 15v.01"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  sprout: '<path d="M12 21v-9"/><path d="M12 12c0-4-3-6-7-6 0 4 3 6 7 6Z"/><path d="M12 10c0-3.5 2.5-6 7-6 0 4-3 6-7 6Z"/>',
  scan: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M4 12h16"/>',
  field: '<path d="M3 20h18"/><path d="M6 20c0-5 1-9 2-12M12 20V6M18 20c0-5-1-9-2-12"/><path d="M12 9c-1.5-1-2-2.5-2-4M12 9c1.5-1 2-2.5 2-4"/>',
  truck: '<path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.5V16h-7z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  handshake: '<path d="m11 17 2 2a1.5 1.5 0 0 0 2-2"/><path d="m14 14 2.5 2.5a1.5 1.5 0 0 0 2-2L15 11"/><path d="M3 11.5 7 7.5l4 1.5 3-1.5 7 4"/><path d="m7 7.5-4 4 6.5 6.5a1.5 1.5 0 0 0 2-2"/>',
  snail: '<path d="M3 18h13a4 4 0 0 0 4-4V9"/><path d="M20 9l1.5-3M20 9l-1.5-3"/><circle cx="10" cy="12" r="5"/><path d="M10 12a2 2 0 1 0 2-2"/>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
