---
import Badge from './Badge.astro';
---
<div class="promo-bar">
  <p class="container promo-bar__inner">
    <Badge variant="promo">4종</Badge>
    <span>건강 목적에 맞게 고르는 다온한끼 건강밥</span>
    <a href="/#products" class="promo-bar__link">제품 고르기 →</a>
  </p>
</div>

<style>
  .promo-bar {
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 14px;
  }
  .promo-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    padding-block: 12px;
    text-align: center;
  }
  .promo-bar__link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: var(--weight-semibold);
    text-underline-offset: 4px;
  }
</style>
